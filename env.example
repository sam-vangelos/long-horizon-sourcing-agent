# Long-Horizon Sourcing Agent — environment template
#
# Copy this file to `.env` at the repository root and populate the keys for
# the source adapters and model seats you intend to run. `shared/config.py`
# loads `.env` with `override=False`, so exported shell variables take
# precedence over values in `.env`.
#
# None of these variables are needed to run `make validate`; the default
# validation suite runs offline with all provider keys unset.

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Primary Anthropic key for strategy planning and full candidate evaluation.
ANTHROPIC_API_KEY=
# Two-account selector (`shared/config.py`): reads PERSONAL_ANTHROPIC_API_KEY
# when set to `personal`, or ANTHROPIC_API_KEY under the default selector.
ANTHROPIC_API_KEY_SOURCE=personal
PERSONAL_ANTHROPIC_API_KEY=
# Required when facial screening or full evaluation routes to Fireworks.
FIREWORKS_API_KEY=
# Optional provider keys when a configured model seat routes to these APIs.
OPENAI_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=

# ---------------------------------------------------------------------------
# Source adapters
# ---------------------------------------------------------------------------
# Required for GitHub / OSS maintainer sourcing (`github/`).
GITHUB_TOKEN=
# Required for open-web sourcing (`exa/`).
EXA_API_KEY=
# Optional public-web evidence augmentation and vocabulary research.
PERPLEXITY_API_KEY=
# Optional OpenAlex polite-pool contact and API key (`researcher/`).
OPENALEX_POLITE_POOL_EMAIL=
OPENALEX_API_KEY=

# ---------------------------------------------------------------------------
# Browser attachment
# ---------------------------------------------------------------------------
# Chrome DevTools Protocol endpoint started by `./launch-chrome.sh`. The
# LinkedIn adapter attaches to an authenticated Recruiter session over CDP
# and never stores or submits platform credentials.
CDP_URL=http://127.0.0.1:9222
# Optional extra CA bundle for TLS-inspecting corporate gateways (`shared/tls.py`).
CLORIS_EXTRA_CA_FILE=

# ---------------------------------------------------------------------------
# Search-kit library (optional)
# ---------------------------------------------------------------------------
SEARCH_KIT_BASE_URL=https://search-kit-library.example.com/kit
SEARCH_KIT_SUPABASE_REST_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
