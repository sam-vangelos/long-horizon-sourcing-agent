# Cloris environment variables.
#
# Copy this file to ``.env`` (which is gitignored) and fill in real values.
# The full key inventory + per-module documentation lands in Phase G.1
# (``docs/cloris-env-runbook.md``); this file is the cost-architecture-
# critical subset surfaced by Slice A.1 of the Multi-Agent Production
# Plan.
#
# Loaded by ``shared/config.py`` at import time. Optional values shown
# with ``=`` plus the recommended setting; required values are commented
# with ``# REQUIRED``.

# === Model provider credentials ===
# Required only when an effective model role below uses that provider.
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# === LinkedIn model roles and standard lifecycle posture ===
# Model substitutions are configuration-only; they do not alter launch,
# queue ownership, resume, or string-lifecycle behavior.
CHEAP_MODEL_PROVIDER=anthropic
CHEAP_MODEL_NAME=claude-haiku-4-5-20251001
STRATEGY_MODEL_NAME=claude-fable-5
FACIAL_MODEL_NAME=accounts/fireworks/models/glm-5p2
FULL_EVAL_MODEL_NAME=accounts/fireworks/models/glm-5p2
OPUS_MODEL_NAME=claude-opus-4-8
SHADOW_STRATEGY_ENABLED=false
SHADOW_FACIAL_MODEL_ENABLED=false
LINKEDIN_PAGE_ALLOCATOR_MODE=off
LINKEDIN_TOTAL_PAGE_CAP=0

# Set only when this machine needs a custom CA bundle.
# SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem

# === GitHub (required for the GitHub module / OSS Maintainers) ===
# REQUIRED for github / OSS-maintainers briefs. Token needs ``read:org``
# and ``read:user`` scopes at minimum. Create at:
#   https://github.com/settings/tokens
# GITHUB_TOKEN=

# === Designer (required for Designer module — see Phase C) ===
# Adobe stopped issuing new Behance v2 keys in 2020; if you don't
# have one, Phase C.5b's CSE-primary fallback architecture lets
# Designer run without it (Behance becomes optional augment).
# BEHANCE_API_KEY=
#
# Google Custom Search Engine — primary acquisition source for
# Designer post-C.5b. Free tier is 100 queries/day; paid tier
# expands to ~10K/day for customer launch.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
#
# Gemini 2.5 Pro — Designer's vision-evaluation pipeline. Required
# at customer-launch (C.10). Configure either Google AI Studio key
# or Vertex AI service account.
# GEMINI_API_KEY=

# === Researcher (etiquette, not blocking) ===
# OpenAlex polite-pool email. Not blocking — the module runs without
# it — but registering grants higher rate limits and an identifiable
# User-Agent. Recommended before customer launch (Phase B.5).
# OPENALEX_POLITE_POOL_EMAIL=

# === Executive Search (optional — graceful degrade) ===
# Each off-LinkedIn signal source degrades to a "section unavailable"
# placeholder in the dossier when its key is missing
# (``exec_search/signals/{crunchbase,news,pitchbook}.py``). Configure
# only the ones the customer needs.
# PERPLEXITY_API_KEY=
# NEWSAPI_KEY=
# CRUNCHBASE_API_KEY=
# PITCHBOOK_API_KEY=

# === LinkedIn browser session ===
# CDP URL for Cloris's dedicated Chrome profile. Default is the
# standard Chrome remote-debugging port. Override only if running
# Chrome on a non-default port.
# CDP_URL=http://127.0.0.1:9222

# === Langfuse observability (Phase 1) ===
# Free tier at https://cloud.langfuse.com handles ~50K observations/mo.
# Required for production trace UI; tests + CI run cleanly without.
# When unset OR LANGFUSE_DISABLE=1, the @observe() decorators in
# shared/observability/__init__.py become passthroughs and runtime
# behavior is byte-equivalent to pre-Phase-1.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# Rollback escape hatch — set to 1 to short-circuit every @observe()
# decorator without removing keys. Use when @observe() overhead causes
# perf regression or Langfuse network hiccups bleed into orchestrator
# latency despite the sticky-degrade in langfuse_client.py.
# LANGFUSE_DISABLE=
